// Prisma Schema for Temar Lije Backend
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String             @id @default(uuid())
  email       String             @unique
  name        String
  role        String             @default("STUDENT") // STUDENT, TEACHER, ADMIN
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  attendances Attendance[]
  enrollments ClassroomStudent[]
  classes     Classroom[]        @relation("TeacherClasses")
  submissions Submission[]
}

model Classroom {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  teacherId   String
  teacher     User               @relation("TeacherClasses", fields: [teacherId], references: [id])
  startTime   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  students    ClassroomStudent[]
  attendances Attendance[]
  liveClasses LiveClass[]
  materials   Material[]
  assignments Assignment[]
}

model ClassroomStudent {
  id        String    @id @default(uuid())
  classId   String
  studentId String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())

  @@unique([classId, studentId])
}

model Attendance {
  id          String    @id @default(uuid())
  classId     String
  studentId   String
  status      String    // PRESENT, LATE, ABSENT
  ipAddress   String?
  checkInTime DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classroom   Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

model LiveClass {
  id        String    @id @default(uuid())
  classId   String
  status    String    @default("ACTIVE") // ACTIVE, ENDED
  startTime DateTime  @default(now())
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Material {
  id          String    @id @default(uuid())
  title       String
  description String?
  filePath    String
  classId     String
  uploadedAt  DateTime  @default(now())
  classroom   Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String       @id @default(uuid())
  title       String
  description String?
  guidePath   String?
  deadline    DateTime
  classId     String
  createdAt   DateTime     @default(now())
  classroom   Classroom    @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  pdfPath      String?
  linkUrl      String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
