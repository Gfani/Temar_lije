# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / SQLite / Prisma)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets (Must be distinct, high-entropy random strings in production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=your_google_oauth_state_signing_secret_here

# Frontend Application URL
FRONTEND_URL=http://localhost:5173
