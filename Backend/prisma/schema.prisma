// Prisma Schema for Temar Lije Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String             @id @default(uuid())
  email       String?            @unique
  name        String
  role        String             @default("STUDENT") // STUDENT, TEACHER, ADMIN
  initials    String?            @default("U")
  avatarBg    String?            @default("#3b82f6")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  attendances Attendance[]
  enrollments ClassroomStudent[]
  classes     Classroom[]        @relation("TeacherClasses")
  members     GroupMember[]
  messages    Message[]
}

model StudyGroup {
  id          String        @id @default(uuid())
  name        String
  description String?
  icon        String?       @default("📚")
  color       String?       @default("#6366f1")
  createdAt   DateTime      @default(now())
  
  messages    Message[]
  members     GroupMember[]
}

model GroupMember {
  userId  String
  groupId String
  role    String     @default("MEMBER")
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model Message {
  id            String      @id @default(uuid())
  text          String?
  image         String?
  type          String      @default("text")
  fileName      String?
  fileSize      String?
  fileIcon      String?
  replyToId     String?
  forwardedFrom String?
  isPinned      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  groupId       String
  group         StudyGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Classroom {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  teacherId   String
  teacher     User               @relation("TeacherClasses", fields: [teacherId], references: [id])
  startTime   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  students    ClassroomStudent[]
  attendances Attendance[]
  liveClasses LiveClass[]
}

model ClassroomStudent {
  id        String    @id @default(uuid())
  classId   String
  studentId String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())

  @@unique([classId, studentId])
}

model Attendance {
  id          String    @id @default(uuid())
  classId     String
  studentId   String
  status      String    // PRESENT, LATE, ABSENT
  ipAddress   String?
  checkInTime DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classroom   Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
}

model LiveClass {
  id        String    @id @default(uuid())
  classId   String
  status    String    @default("ACTIVE") // ACTIVE, ENDED
  startTime DateTime  @default(now())
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
}
